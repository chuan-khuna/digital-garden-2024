---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
// import PostCard from '@/components/post/PostCard.astro'
import PostMasonry from '@/components/post/PostMasonry.astro'

const collectionsInThisPage = ['posts', 'notes'] as const

// Dynamically load all collections from the list
const allArticles = (
  await Promise.all(
    collectionsInThisPage.map(async (collectionName) => {
      const items = await getCollection(collectionName as any)
      return items.map((item) => ({
        ...item,
        collection: collectionName,
      }))
    }),
  )
).flat()

// Sort articles by date (newest first)
const allArticleSortedByDate = allArticles.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0
  const updatedA = a.data.updated ? new Date(a.data.updated).getTime() : 0
  const maxA = Math.max(dateA, updatedA)

  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0
  const updatedB = b.data.updated ? new Date(b.data.updated).getTime() : 0
  const maxB = Math.max(dateB, updatedB)

  return maxB - maxA
})

const meta = {
  title: 'Garden',
  description: 'A collection of my digital garden notes and thoughts',
}
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="m-auto w-full max-w-6xl px-2 pb-8 pt-4 sm:px-4 md:px-6 md:pt-6">
    <PostMasonry articles={allArticleSortedByDate} maxColumns={3} />
  </div>
</BaseLayout>
