---
// Single-column Resume Print Page for a non-default Resume Version:
// /resume-print-single-column/<version>. Noindexed and not linked from anywhere.
import type { GetStaticPaths } from 'astro'
import ResumePrintPage from '@/components/resume/pages/ResumePrintPage.astro'
import { getResume, getResumeVersions } from '@/lib/resume'

export const getStaticPaths = (async () => {
  const versions = await getResumeVersions()
  return versions.map((version) => ({ params: { version } }))
}) satisfies GetStaticPaths

const { version } = Astro.params
const resume = await getResume('resume_print', version)
---

<ResumePrintPage resume={resume} layout="single-column" noindex />
