---
// import BaseLayoutPrint from '@/layouts/BaseLayoutPrint.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
// sections
import Experiences from '@/components/resume/sections/Experiences.astro'
import Projects from '@/components/resume/sections/Projects.astro'
import Activity from '@/components/resume/sections/Activity.astro'
import Skills from '@/components/resume/sections/Skills.astro'
import Education from '@/components/resume/sections/Education.astro'
import Interests from '@/components/resume/sections/Interests.astro'
import Now from '@/components/resume/sections/Now.astro'

import { getResume } from '@/lib/resume'
import SectionBlock from '@/components/resume/SectionBlock.astro'
import { site } from '@/data/site.config'
import { pageOgImage } from '@/lib/og-image'

// The web resume always shows the Default Version (`index`) on the `web` Surface.
const {
  header,
  experiences,
  projects,
  activities,
  skills,
  educations,
  interests,
  now: nowEntry,
} = await getResume('web')

const textGrayClasses = 'text-gray-500 dark:text-gray-500'

const ogImageUrl = await pageOgImage('resume')
---

<BaseLayout
  title={`${site.displayName}'s Resume`}
  description=""
  ogImage={ogImageUrl}
>
  <div class="">
    <!-- resume layout -->
    <div
      class="mx-auto grid max-w-[1200px] grid-cols-1 gap-2 p-2 md:grid-cols-2"
    >
      <!-- header: name and summary -->
      <div class="md:col-span-2" name="header-summary">
        <div class="relative border p-4">
          <div class="md:flex">
            <div>
              <h1 class="text-4xl font-bold">{header.name}</h1>
              <p class=`${textGrayClasses} text-xl`>{header.jobTitle}</p>
            </div>
          </div>
          <div class="mt-4 md:flex">
            <div name="summary">
              <p>
                {header.introduction}
              </p>
            </div>
            <div
              class="mt-4 w-full max-w-[400px] md:mt-0 md:pl-8 md:text-right"
              name="contact-info"
            >
              <p>
                <span class="font-medium">Github</span>:
                <a
                  href={header.github}
                  target="_blank"
                  rel="noreferrer"
                  class="underline"
                >
                  {header.githubName}
                </a>
              </p>
              <p>
                <span class="font-medium">Email</span>: {header.email}
              </p>
              <p>
                <span class="font-medium">Location</span>: {header.location}
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- detail -->
      <div class="block space-y-2" name="detail-left">
        <Experiences data={experiences} />
        <Projects data={projects} />
        <Activity data={activities} />
      </div>
      <div class="block space-y-2" name="detail-right">
        <Skills data={skills} />
        <Education data={educations} />
        <Interests items={interests} />
        <Now data={nowEntry} />
        <div class="print:hidden">
          <SectionBlock title="">
            <ul class="not-prose">
              <li
                class="flex items-baseline justify-between gap-4 border-b border-dashed pb-3"
              >
                <a href="/resume-print" class="underline hover:text-primary">
                  Print resume
                </a>
                <span class="text-sm text-muted-foreground">1 page</span>
              </li>
              <li class="flex items-baseline justify-between gap-4 pt-3">
                <a href="/resume-print?layout=cv" class="underline hover:text-primary">
                  Print CV
                </a>
                <span class="text-sm text-muted-foreground">
                  Full, multi-page
                </span>
              </li>
            </ul>
          </SectionBlock>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
