---
import AISparkleIcon from './AISparkleIcon.astro'

const { frontmatter } = Astro.props
---

<header>
  <div class="mb-4">
    <span class="font-serif text-4xl font-bold">
      {frontmatter.title}
    </span>
  </div>
  {
    frontmatter.description && (
      <div>
        <p class="text-cactus-text-secondary text-md">
          {frontmatter.description}
        </p>
      </div>
    )
  }
  <div
    class="text-cactus-text-muted my-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
  >
    {
      frontmatter.date && (
        <time datetime={frontmatter.date}>
          {new Date(frontmatter.date).toLocaleDateString('en-UK', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )
    }
    {
      frontmatter.updated && (
        <>
          <span class="hidden sm:inline">/</span>
          <span class="w-full sm:w-auto">
            Updated:{' '}
            {new Date(frontmatter.updated).toLocaleDateString('en-UK', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
        </>
      )
    }
    {
      frontmatter.llmAssisted && (
        <>
          <span class="hidden sm:inline">/</span>
          <span
            class="flex w-full items-center gap-1 sm:w-auto"
            title="Written with AI assistance."
          >
            <AISparkleIcon />
            Written with AI assistance
          </span>
        </>
      )
    }
  </div>
  {
    frontmatter.tags && frontmatter.tags.length > 0 && (
      <ul
        class="not-prose my-3 flex list-none flex-wrap items-center gap-1.5 p-0"
        aria-label="Tags"
      >
        {frontmatter.tags.map((tag: string) => (
          <li class="bg-accent/10 text-foreground/80 rounded-[4px] px-2 py-0.5 font-mono text-xs">
            <span class="text-accent" aria-hidden="true">
              #
            </span>
            {tag}
          </li>
        ))}
      </ul>
    )
  }
  <slot />
  <hr class="border-foreground my-2 border-dashed opacity-30" />
</header>
