---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'

interface Props {
  articles: (CollectionEntry<'posts'> | CollectionEntry<'notes'>)[]
  maxColumns?: keyof typeof columnClasses
}

// Every breakpoint is spelled out so Tailwind's scanner sees the class names.
// An inline `column-count` style would beat the responsive utilities and force
// the same column count on every viewport.
const columnClasses = {
  1: 'columns-1',
  2: 'columns-1 sm:columns-2',
  3: 'columns-1 sm:columns-2 lg:columns-3',
  4: 'columns-1 sm:columns-2 lg:columns-4',
} as const

const { articles, maxColumns = 3 } = Astro.props
---

<div class:list={['gap-4', columnClasses[maxColumns]]}>
  {
    articles.map((article) => (
      <div class="mb-4 break-inside-avoid">
        <PostCard article={article} rootURL={article.collection} />
      </div>
    ))
  }
</div>
