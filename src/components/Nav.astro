---
import ThemeToggle from '@/components/ThemeToggle.astro'
import { Menu, X as Close } from 'lucide-react'
import { getCollection } from 'astro:content'
import { site } from '@/data/site.config'

const navItems = (await getCollection('navItems'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => item.data)

const currentPath = Astro.url.pathname
const isActive = (link: string) =>
  link === '/' ? currentPath === '/' : currentPath.startsWith(link)
---

<header
  class="border-border bg-background sticky top-0 z-50 w-full border-b print:hidden"
>
  <div
    class="mx-auto flex h-12 max-w-[1440px] items-stretch justify-between px-4 md:px-6"
  >
    <a
      href="/"
      class="text-foreground flex items-center font-serif text-lg leading-none"
    >
      {site.displayName}
    </a>

    <div class="flex items-stretch">
      <nav aria-label="Main" class="hidden items-stretch gap-x-6 md:flex">
        {
          navItems.map((item) => (
            <a
              href={item.link}
              aria-current={isActive(item.link) ? 'page' : undefined}
              class="text-foreground/70 hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:border-primary -mb-px flex items-center border-b-2 border-transparent text-sm transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-1 md:ml-5">
        <ThemeToggle />
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="text-foreground/70 hover:text-foreground hover:bg-border focus-visible:ring-ring flex h-8 w-8 cursor-pointer items-center justify-center rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 md:hidden"
        >
          <Menu className="h-4 w-4" data-icon="open" />
          <Close className="hidden h-4 w-4" data-icon="close" />
        </button>
      </div>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Main"
    class="border-border hidden border-t md:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.link}
          aria-current={isActive(item.link) ? 'page' : undefined}
          class="text-foreground/70 hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:border-primary block border-l-2 border-transparent px-4 py-3 text-sm"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle')
  const menu = document.getElementById('mobile-nav')

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true'
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    menu?.classList.toggle('hidden', !open)
    toggle
      .querySelector('[data-icon="open"]')
      ?.classList.toggle('hidden', open)
    toggle
      .querySelector('[data-icon="close"]')
      ?.classList.toggle('hidden', !open)
  })
</script>
