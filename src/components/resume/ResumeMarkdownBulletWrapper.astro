---
// Bullets from a markdown body (experiences, projects). A class on a wrapper,
// because scoped styles can't reach slotted markdown. Print bullets use
// `.rp-list` from `@/styles/resume-print.css`.
interface Props {
  variant?: 'web' | 'print'
}

const { variant = 'web' } = Astro.props

const webClasses =
  '[&_ul]:text-sm [&_ul]:my-2 [&_ul]:list-disc [&_ul]:pl-3 [&_li]:marker:text-gray-500 [&_li_p]:m-0 [&_li_p]:p-0 [&_li_p]:inline [&_strong]:font-bold'
---

<div class={variant === 'print' ? 'rp-list' : webClasses}>
  <slot />
</div>
