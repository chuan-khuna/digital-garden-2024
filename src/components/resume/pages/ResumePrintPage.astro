---
// Print Page. Rendered for the Default Version at /resume-print and for every
// other Resume Version at /resume-print/<version>.
//
// Every Print Layout is rendered; an on-screen selector shows one and hides
// the rest (hidden layouts don't print either). A second selector hides
// individual Sections; the header always shows. A layout can hide Sections by
// default (`data-default-hide`), and switching layout resets the Section
// toggles to that layout's defaults. Both choices live in the URL —
// `?layout=<name>&hide=<section>,<section>` — so they can be linked directly,
// e.g. /resume-print?layout=cv&hide=interests. Without JS the default layout
// shows with every Section.
import BaseLayoutPrint from '@/layouts/BaseLayoutPrint.astro'
import { site } from '@/data/site.config'
import type { Resume } from '@/lib/resume'

// layout
import PageLayout from '@/components/resume/layout/PageLayout.astro'
import Content from '@/components/resume/layout/Content.astro'
import WebWrapper from '@/components/resume/layout/WebWrapper.astro'
import PrintPageBreak from '@/components/resume/PrintPageBreak.astro'

// sections
import PrintHeader from '@/components/resume/sections/print/Header.astro'
import Experiences from '@/components/resume/sections/Experiences.astro'
import Skills from '@/components/resume/sections/Skills.astro'
import Projects from '@/components/resume/sections/Projects.astro'
import Education from '@/components/resume/sections/Education.astro'
import Interests from '@/components/resume/sections/Interests.astro'
import Activity from '@/components/resume/sections/Activity.astro'

interface Props {
  /** Resolved for the `resume_print` Surface (one-page layouts). */
  resume: Resume
  /** Resolved for the `cv_print` Surface (the CV layout). */
  cv: Resume
  noindex?: boolean
}

const { resume, cv, noindex = false } = Astro.props

/** Print Layouts, first is the default. Names are the `?layout=` values. */
const layouts = [
  { name: 'resume-two-cols', label: 'Resume · 2 columns' },
  { name: 'resume-one-col', label: 'Resume · 1 column' },
  { name: 'cv', label: 'CV · multi-page' },
] as const
const defaultLayout = layouts[0].name

/** Sections that can be hidden. Names are the `?hide=` values. */
const sections = [
  { name: 'skills', label: 'Skills' },
  { name: 'experiences', label: 'Experience' },
  { name: 'projects', label: 'Projects' },
  { name: 'educations', label: 'Education' },
  { name: 'activities', label: 'Activity' },
  { name: 'interests', label: 'Interests' },
] as const

const toggleGroupClass =
  'border-border mx-auto flex flex-wrap justify-center gap-1 rounded-lg border p-1 text-sm'
const toggleClass =
  'text-foreground/55 hover:text-foreground aria-pressed:bg-muted aria-pressed:text-muted-foreground rounded-md px-3 py-1'

const cvPageClass = 'px-12 py-4 font-resumesans'
---

<BaseLayoutPrint
  title={`${site.displayName}'s Resume`}
  description=""
  noindex={noindex}
>
  <div class="flex flex-col gap-2 print:hidden">
    <div role="group" aria-label="Print layout" class={toggleGroupClass}>
      {
        layouts.map(({ name, label }) => (
          <button
            type="button"
            data-layout-option={name}
            aria-pressed={name === defaultLayout ? 'true' : 'false'}
            class={toggleClass}
          >
            {label}
          </button>
        ))
      }
    </div>

    <div role="group" aria-label="Sections shown" class={toggleGroupClass}>
      {
        sections.map(({ name, label }) => (
          <button
            type="button"
            data-section-option={name}
            aria-pressed="true"
            class={toggleClass}
          >
            {label}
          </button>
        ))
      }
    </div>
  </div>

  <WebWrapper className="flex min-h-screen flex-col justify-center">
    <div data-layout="resume-two-cols" class="contents">
      <PageLayout className="px-8 py-4 font-resumesans">
        <Content className="mx-auto grid max-w-[1200px] grid-cols-7 gap-4">
          <div class="col-span-7">
            <PrintHeader header={resume.header} />
          </div>

          <div class="col-span-2 block space-y-1">
            <div data-section="skills">
              <Skills data={resume.skills} variant="print" />
            </div>
            <div data-section="activities">
              <Activity data={resume.activities} variant="print" />
            </div>
            <div data-section="interests">
              <Interests items={resume.interests} variant="print" />
            </div>
          </div>

          <div class="col-span-5 block space-y-1">
            <div data-section="experiences">
              <Experiences data={resume.experiences} variant="print" />
            </div>
            <div data-section="projects">
              <Projects data={resume.projects} variant="print" />
            </div>
            <div data-section="educations">
              <Education data={resume.educations} variant="print" />
            </div>
          </div>
        </Content>
      </PageLayout>
    </div>

    <div
      data-layout="resume-one-col"
      data-default-hide="interests"
      class="contents"
      hidden
    >
      <PageLayout className="px-12 py-4 font-resumesans">
        <Content className="mx-auto max-w-[1200px] space-y-1">
          <div class="mb-2">
            <PrintHeader header={resume.header} />
          </div>
          <div data-section="skills">
            <Skills data={resume.skills} variant="print" />
          </div>
          <div data-section="experiences">
            <Experiences data={resume.experiences} variant="print" />
          </div>
          <div data-section="projects">
            <Projects data={resume.projects} variant="print" />
          </div>
          <div data-section="educations">
            <Education data={resume.educations} variant="print" />
          </div>
          <div data-section="activities">
            <Activity data={resume.activities} variant="print" />
          </div>
          <div data-section="interests">
            <Interests items={resume.interests} variant="print" />
          </div>
        </Content>
      </PageLayout>
    </div>

    <div data-layout="cv" class="contents" hidden>
      <PageLayout className={cvPageClass}>
        <Content className="mx-auto max-w-[1200px]">
          <div class="mb-2">
            <PrintHeader header={cv.header} />
          </div>

          <div class="space-y-1">
            <div data-section="skills">
              <Skills data={cv.skills} variant="print" />
            </div>
            <div data-section="experiences">
              <Experiences data={cv.experiences} variant="print" />
            </div>
            <div data-section="educations">
              <Education data={cv.educations} variant="print" />
            </div>
            <div data-section="projects">
              <Projects data={cv.projects} variant="print" />
            </div>
          </div>
        </Content>
      </PageLayout>

      <PrintPageBreak />

      <PageLayout className={cvPageClass}>
        <Content className="mx-auto max-w-[1200px]">
          <div class="space-y-1">
            <div data-section="activities">
              <Activity data={cv.activities} variant="print" />
            </div>
            <div data-section="interests">
              <Interests items={cv.interests} variant="print" />
            </div>
          </div>
        </Content>
      </PageLayout>
    </div>
  </WebWrapper>
</BaseLayoutPrint>

<script>
  const layouts = [...document.querySelectorAll<HTMLElement>('[data-layout]')]
  const layoutOptions = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-layout-option]'),
  ]
  const layoutNames = layouts.map((el) => el.dataset.layout!)
  const defaultLayout = layoutNames[0]

  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')]
  const sectionOptions = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-section-option]'),
  ]
  const sectionNames = sectionOptions.map((btn) => btn.dataset.sectionOption!)

  function parseHide(value: string): Set<string> {
    return new Set(value.split(',').filter((n) => sectionNames.includes(n)))
  }

  /** Sections a layout hides until toggled on (`data-default-hide`). */
  function defaultHidden(name: string): Set<string> {
    const el = layouts.find((l) => l.dataset.layout === name)
    return parseHide(el?.dataset.defaultHide ?? '')
  }

  const params = new URLSearchParams(location.search)
  const requestedLayout = params.get('layout')
  let layout =
    requestedLayout && layoutNames.includes(requestedLayout)
      ? requestedLayout
      : defaultLayout
  // `?hide=` (even empty) overrides the layout's defaults.
  const requestedHide = params.get('hide')
  let hidden =
    requestedHide === null ? defaultHidden(layout) : parseHide(requestedHide)

  function render() {
    for (const el of layouts) el.hidden = el.dataset.layout !== layout
    for (const btn of layoutOptions) {
      btn.setAttribute(
        'aria-pressed',
        String(btn.dataset.layoutOption === layout),
      )
    }
    for (const el of sections) el.hidden = hidden.has(el.dataset.section!)
    for (const btn of sectionOptions) {
      btn.setAttribute(
        'aria-pressed',
        String(!hidden.has(btn.dataset.sectionOption!)),
      )
    }
  }

  function saveToUrl() {
    const url = new URL(location.href)
    if (layout === defaultLayout) url.searchParams.delete('layout')
    else url.searchParams.set('layout', layout)
    // Keep `hide` in Section order so the URL is stable; omit it when it
    // matches the layout's defaults.
    const hide = sectionNames.filter((name) => hidden.has(name)).join(',')
    const defaults = sectionNames
      .filter((name) => defaultHidden(layout).has(name))
      .join(',')
    if (hide === defaults) url.searchParams.delete('hide')
    else url.searchParams.set('hide', hide)
    history.replaceState(null, '', url)
  }

  render()

  for (const btn of layoutOptions) {
    btn.addEventListener('click', () => {
      layout = btn.dataset.layoutOption!
      hidden = defaultHidden(layout)
      render()
      saveToUrl()
    })
  }

  for (const btn of sectionOptions) {
    btn.addEventListener('click', () => {
      const name = btn.dataset.sectionOption!
      if (hidden.has(name)) hidden.delete(name)
      else hidden.add(name)
      render()
      saveToUrl()
    })
  }
</script>
