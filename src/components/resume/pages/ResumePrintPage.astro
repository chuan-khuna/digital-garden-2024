---
// Print Page. Rendered for the Default Version at /resume-print and for every
// other Resume Version at /resume-print/<version>.
//
// Every Print Layout is rendered; an on-screen selector shows one and hides
// the rest (hidden layouts don't print either). A second selector hides
// individual Sections; the header always shows. The layouts, their Surfaces
// and arrangements, and the `?layout=` / `?hide=` selection rules live in
// `@/lib/resume/print-layouts`; this file renders them and the script below
// applies them to the DOM. Without JS the default layout shows with every
// Section.
import BaseLayoutPrint from '@/layouts/BaseLayoutPrint.astro'
import { site } from '@/data/site.config'
import { DEFAULT_RESUME_VERSION, getResume } from '@/lib/resume'
import {
  DEFAULT_PRINT_LAYOUT,
  PRINT_LAYOUTS,
  PRINT_SECTIONS,
} from '@/lib/resume/print-layouts'

// layout
import PageLayout from '@/components/resume/layout/PageLayout.astro'
import WebWrapper from '@/components/resume/layout/WebWrapper.astro'
import PrintPageBreak from '@/components/resume/PrintPageBreak.astro'

// sections
import PrintHeader from '@/components/resume/sections/print/Header.astro'
import PrintSection from '@/components/resume/sections/print/Section.astro'

interface Props {
  /** The Resume Version to print; defaults to the Default Version. */
  version?: string
}

const { version = DEFAULT_RESUME_VERSION } = Astro.props

// Only the Default Version is indexed.
const noindex = version !== DEFAULT_RESUME_VERSION

const [resumePrint, cvPrint] = await Promise.all([
  getResume('resume_print', version),
  getResume('cv_print', version),
])
const bySurface = { resume_print: resumePrint, cv_print: cvPrint }

const toggleGroupClass =
  'border-border mx-auto flex flex-wrap justify-center gap-1 rounded-lg border p-1 text-sm'
const toggleClass =
  'text-foreground/55 hover:text-foreground aria-pressed:bg-muted aria-pressed:text-muted-foreground rounded-md px-3 py-1'
---

<BaseLayoutPrint
  title={`${site.displayName}'s Resume`}
  description=""
  noindex={noindex}
>
  <div class="flex flex-col gap-2 print:hidden">
    <div role="group" aria-label="Print layout" class={toggleGroupClass}>
      {
        PRINT_LAYOUTS.map(({ name, label }) => (
          <button
            type="button"
            data-layout-option={name}
            aria-pressed={name === DEFAULT_PRINT_LAYOUT ? 'true' : 'false'}
            class={toggleClass}
          >
            {label}
          </button>
        ))
      }
    </div>

    <div role="group" aria-label="Sections shown" class={toggleGroupClass}>
      {
        PRINT_SECTIONS.map(({ name, label }) => (
          <button
            type="button"
            data-section-option={name}
            aria-pressed="true"
            class={toggleClass}
          >
            {label}
          </button>
        ))
      }
    </div>
  </div>

  <WebWrapper className="flex min-h-screen flex-col justify-center">
    {
      PRINT_LAYOUTS.map(({ name, surface, arrangement }) => {
        const resume = bySurface[surface]
        return (
          <div
            data-layout={name}
            class="contents"
            hidden={name !== DEFAULT_PRINT_LAYOUT}
          >
            {name === 'resume-two-cols' && (
              <PageLayout className="px-8 py-4 font-resumesans">
                <div class="mx-auto grid max-w-[1200px] grid-cols-7 gap-4">
                  <div class="col-span-7">
                    <PrintHeader header={resume.header} />
                  </div>
                  {arrangement.map((column, i) => (
                    <div
                      class:list={[
                        'block space-y-1',
                        i === 0 ? 'col-span-2' : 'col-span-5',
                      ]}
                    >
                      {column.map((section) => (
                        <PrintSection name={section} resume={resume} />
                      ))}
                    </div>
                  ))}
                </div>
              </PageLayout>
            )}

            {name === 'resume-one-col' && (
              <PageLayout className="px-12 py-4 font-resumesans">
                <div class="mx-auto max-w-[1200px] space-y-1">
                  <div class="mb-2">
                    <PrintHeader header={resume.header} />
                  </div>
                  {arrangement[0].map((section) => (
                    <PrintSection name={section} resume={resume} />
                  ))}
                </div>
              </PageLayout>
            )}

            {name === 'cv' &&
              arrangement.map((page, i) => (
                <>
                  {i > 0 && <PrintPageBreak />}
                  <PageLayout className="px-12 py-4 font-resumesans">
                    <div class="mx-auto max-w-[1200px]">
                      {i === 0 && (
                        <div class="mb-2">
                          <PrintHeader header={resume.header} />
                        </div>
                      )}
                      <div class="space-y-1">
                        {page.map((section) => (
                          <PrintSection name={section} resume={resume} />
                        ))}
                      </div>
                    </div>
                  </PageLayout>
                </>
              ))}
          </div>
        )
      })
    }
  </WebWrapper>
</BaseLayoutPrint>

<script>
  import {
    parseSelection,
    selectLayout,
    toggleSection,
    writeSelection,
    type PrintLayoutName,
    type PrintSection,
  } from '@/lib/resume/print-layouts'

  const layouts = [...document.querySelectorAll<HTMLElement>('[data-layout]')]
  const layoutOptions = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-layout-option]'),
  ]
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')]
  const sectionOptions = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-section-option]'),
  ]

  let selection = parseSelection(new URLSearchParams(location.search))

  function render() {
    for (const el of layouts) el.hidden = el.dataset.layout !== selection.layout
    for (const btn of layoutOptions) {
      btn.setAttribute(
        'aria-pressed',
        String(btn.dataset.layoutOption === selection.layout),
      )
    }
    const isHidden = (name?: string) =>
      selection.hidden.has(name as PrintSection)
    for (const el of sections) el.hidden = isHidden(el.dataset.section)
    for (const btn of sectionOptions) {
      btn.setAttribute(
        'aria-pressed',
        String(!isHidden(btn.dataset.sectionOption)),
      )
    }
  }

  function update(next: typeof selection) {
    selection = next
    render()
    const url = new URL(location.href)
    writeSelection(url.searchParams, selection)
    history.replaceState(null, '', url)
  }

  render()

  for (const btn of layoutOptions) {
    btn.addEventListener('click', () =>
      update(selectLayout(btn.dataset.layoutOption as PrintLayoutName)),
    )
  }

  for (const btn of sectionOptions) {
    btn.addEventListener('click', () =>
      update(
        toggleSection(selection, btn.dataset.sectionOption as PrintSection),
      ),
    )
  }
</script>
