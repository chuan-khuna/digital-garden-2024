---
// Index of every Resume Version for one Print Page kind, rendered at
// /resume-print/versions and /cv-print/versions. Noindexed and not linked from
// the site, like the version pages themselves.
import BaseLayoutPrint from '@/layouts/BaseLayoutPrint.astro'
import { site } from '@/data/site.config'
import {
  DEFAULT_RESUME_VERSION,
  getResume,
  getResumeVersions,
  type Surface,
} from '@/lib/resume'

interface Props {
  surface: Extract<Surface, 'resume_print' | 'cv_print'>
}

const { surface } = Astro.props

const kind = surface === 'resume_print' ? 'Resume' : 'CV'
const basePath = surface === 'resume_print' ? '/resume-print' : '/cv-print'

const versions = await Promise.all(
  [DEFAULT_RESUME_VERSION, ...(await getResumeVersions())].map(
    async (version) => {
      const { header } = await getResume(surface, version)
      const isDefault = version === DEFAULT_RESUME_VERSION
      return {
        version,
        isDefault,
        href: isDefault ? basePath : `${basePath}/${version}`,
        jobTitle: header.jobTitle,
      }
    },
  ),
)
---

<BaseLayoutPrint
  title={`${site.displayName}'s ${kind} Versions`}
  description=""
  noindex
>
  <div class="mx-auto w-full max-w-2xl space-y-6">
    <header class="space-y-1">
      <h1 class="text-foreground font-serif text-3xl">{kind} versions</h1>
      <p class="text-muted-foreground text-sm">
        {versions.length} Resume Versions. Each link opens the {kind} Print Page for
        that version.
      </p>
    </header>

    <ul class="divide-border border-border divide-y border-y">
      {
        versions.map(({ version, isDefault, href, jobTitle }) => (
          <li>
            <a
              href={href}
              class="text-foreground hover:text-primary flex items-baseline justify-between gap-4 py-3"
            >
              <span class="font-mono">
                {version}
                {isDefault && (
                  <span class="text-muted-foreground ml-2 text-xs">
                    Default Version
                  </span>
                )}
              </span>
              <span class="text-muted-foreground text-right text-sm">
                {jobTitle}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayoutPrint>
