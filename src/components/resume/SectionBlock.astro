---
interface Props {
  title: string
  variant?: 'web' | 'print'
}

const { title, variant = 'web' } = Astro.props
---

{
  variant === 'print' ? (
    <section class="rp-section">
      {title && <h2 class="rp-section-title">{title}</h2>}
      <slot />
    </section>
  ) : (
    <div class="prose-cactus prose relative max-w-full border p-4 md:block print:break-inside-avoid">
      {title && <h1 class="text-2xl">{title}</h1>}
      <slot />
    </div>
  )
}
