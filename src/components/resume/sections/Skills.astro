---
import SectionBlock from '@/components/resume/SectionBlock.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  data: CollectionEntry<'resumeSkills'>[]
  variant?: 'web' | 'print'
  separator?: string
}

const { data, variant = 'web' } = Astro.props
const separator = Astro.props.separator ?? (variant === 'print' ? ', ' : ' · ')
---

<SectionBlock title="Skills" variant={variant}>
  {
    variant === 'print' ? (
      <div class="rp-skills">
        {data.map((skill) => (
          <>
            <div class="rp-skill-category">{skill.data.category}</div>
            <div class="rp-skill-items">
              {skill.data.details.join(separator)}
            </div>
          </>
        ))}
      </div>
    ) : (
      <div>
        {data.map((skill) => (
          <div class="mb-1 text-sm">
            <span class="mr-1 font-medium">{skill.data.category}:</span>
            <span>{skill.data.details.join(separator)}</span>
          </div>
        ))}
      </div>
    )
  }
</SectionBlock>
