---
// Print Page header: name, job title, contact info and introduction.
// Styled by `rp-*` classes in `@/styles/resume-print.css`.
import type { Resume } from '@/lib/resume'

interface Props {
  header: Resume['header']
  /**
   * Put the contact info on one line above the introduction (one-column and
   * CV layouts) instead of in a column beside it (two-column layout).
   */
  stacked?: boolean
}

const { header, stacked = false } = Astro.props

// "https://altrf.dev/" -> "altrf.dev"
const shortUrl = (url: string) =>
  url.replace(/^https?:\/\//, '').replace(/\/$/, '')

const contacts: { value: string; href?: string }[] = [
  { value: header.location },
  { value: header.email, href: `mailto:${header.email}` },
  { value: shortUrl(header.github), href: header.github },
  ...(header.website
    ? [{ value: shortUrl(header.website), href: header.website }]
    : []),
]
---

<header>
  <h1 class="rp-name">{header.name}</h1>
  <p class="rp-job-title">{header.jobTitle}</p>
  {
    stacked ? (
      <>
        <p class="rp-contacts">
          {contacts.map((c, i) => (
            <>
              {i > 0 && (
                <span class="rp-contacts-sep" aria-hidden="true">
                  |
                </span>
              )}
              {c.href ? (
                <a href={c.href} target="_blank" rel="noreferrer">
                  {c.value}
                </a>
              ) : (
                <span>{c.value}</span>
              )}
            </>
          ))}
        </p>
        <p class="rp-summary">{header.introduction}</p>
      </>
    ) : (
      <div class="rp-header-split">
        <p class="rp-summary">{header.introduction}</p>
        <div class="rp-contacts-stacked">
          {contacts.map((c) => (
            <p>
              {c.href ? (
                <a href={c.href} target="_blank" rel="noreferrer">
                  {c.value}
                </a>
              ) : (
                c.value
              )}
            </p>
          ))}
        </div>
      </div>
    )
  }
</header>
