---
import ListItem from './ListItem.astro'

interface Props {
  items: string[]
  ulClass?: string
  variant?: 'web' | 'print'
}

const { items, ulClass = '', variant = 'web' } = Astro.props
---

{
  variant === 'print' ? (
    items.length > 0 && (
      <ul class="rp-list">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  ) : (
    <div>
      <ul class={`${ulClass} my-2`}>
        {items.map((item) => (
          <ListItem>{item}</ListItem>
        ))}
      </ul>
    </div>
  )
}
