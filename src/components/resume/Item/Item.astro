---
// One entry's heading: a job, project, degree or activity.
//
// web:   title, then description and time, then the URL.
// print: title and short URL left, time right on one baseline; description
//        below. Styled by `rp-*` classes in `@/styles/resume-print.css`.

interface Props {
  title: string
  timeDescription?: string
  description?: string
  url?: string
  variant?: 'web' | 'print'
}

const {
  title,
  timeDescription,
  description,
  url,
  variant = 'web',
} = Astro.props

// "https://github.com/x/" -> "github.com/x"
const urlLabel = url?.replace(/^https?:\/\//, '').replace(/\/$/, '')
// "Jul 2022 - Present" -> "Jul 2022 – Present"
const printTime = timeDescription?.replace(' - ', ' – ')
---

{
  variant === 'web' ? (
    <div>
      <span class="text-lg">{title}</span>
      <div class="mt-1 md:flex">
        {description && (
          <div class="w-full text-left">
            <span class="text-sm">{description}</span>
          </div>
        )}
        {timeDescription && (
          <div class="w-full max-w-[24ch] pr-8 md:text-right">
            <span class="text-sm">{timeDescription}</span>
          </div>
        )}
      </div>
      {url && (
        <div class="md:flex">
          <div class="w-full text-left">
            <a href={url} class="text-sm hover:underline">
              {url}
            </a>
          </div>
        </div>
      )}
    </div>
  ) : (
    <div>
      <div class="rp-entry-head">
        <span class="rp-entry-title">{title}</span>
        {url && (
          <a href={url} target="_blank" rel="noreferrer" class="rp-entry-url">
            {urlLabel}
          </a>
        )}
        {printTime && <span class="rp-entry-time">{printTime}</span>}
      </div>
      {description && <div class="rp-entry-description">{description}</div>}
    </div>
  )
}
