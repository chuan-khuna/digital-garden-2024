---
// Page break between CV sheets.
//
// In PRINT this forces the page break exactly as before: the `page-break-after`
// div and the following `mt-4` spacer are unchanged. (The old on-screen
// "PAGE BREAK" label was already `print:hidden`, so removing it leaves print
// output identical.)
//
// On SCREEN the sheets are already separated by the canvas gap, so both spacers
// are hidden — no break chrome is shown.
---

<div style="page-break-after: always;" class="resume-pagebreak"></div>
<div class="mt-4 resume-pagebreak"></div>

<style>
  @media screen {
    .resume-pagebreak {
      display: none;
    }
  }
</style>
