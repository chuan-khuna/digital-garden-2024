---
// Page break between CV sheets.
//
// In PRINT this forces a page break; the next sheet's own padding supplies
// the top margin.
//
// On SCREEN the sheets are already separated by the canvas gap, so the break
// element is hidden — no break chrome is shown.
---

<div style="page-break-after: always;" class="resume-pagebreak"></div>

<style>
  @media screen {
    .resume-pagebreak {
      display: none;
    }
  }
</style>
